{
  "name": "patchwork",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Patchwork — make useful things from what you already own.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js --reset",
    "dev:static": "vite --mode static",
    "build:static": "vite build --mode static --outDir dist-static"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
